{
  "manifest_version": 3,
  "name": "SIG Advocacia Colombo — Conector e-SAJ",
  "version": "1.1.1",
  "description": "Captura processos abertos ou atualiza em lote os processos do e-SAJ usando a sessão autenticada do navegador.",
  "permissions": ["storage", "activeTab", "tabs", "clipboardRead", "clipboardWrite"],
  "host_permissions": ["https://esaj.tjsp.jus.br/*"],
  "action": {
    "default_title": "SIG — Conector e-SAJ",
    "default_popup": "popup2.html"
  },
  "content_scripts": [
    {
      "matches": ["https://esaj.tjsp.jus.br/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
